          </thead>
          <tbody>
            {ev.materials.map(m=>{
              const mc=MAT_COLORS[m.status];
              const resp=m.customName||m.responsible;
              const dl=daysLeft(m.dueDate);
              return(
                <tr key={m.id} style={{borderBottom:"0.5px solid var(--color-border-tertiary)"}}>
                  <td style={{padding:"7px 8px",fontWeight:500,color:"var(--color-text-primary)"}}>{m.item}</td>
                  <td style={{padding:"7px 8px",color:"var(--color-text-secondary)",whiteSpace:"nowrap"}}>{m.qty}{m.unit?" "+m.unit:""}</td>
                  <td style={{padding:"7px 8px"}}>
                    {resp?<span style={{fontSize:11,padding:"1px 7px",borderRadius:99,background:"var(--color-background-secondary)",color:"var(--color-text-secondary)",border:"0.5px solid var(--color-border-tertiary)"}}>{resp}</span>:<span style={{color:"var(--color-text-tertiary)"}}>—</span>}
                  </td>
                  <td style={{padding:"7px 8px",whiteSpace:"nowrap"}}>
                    {m.dueDate?<span style={{fontSize:11,color:dl!==null&&dl<=7&&m.status!=="Done"?"#854F0B":"var(--color-text-secondary)"}}>{fmt(m.dueDate)}</span>:<span style={{color:"var(--color-text-tertiary)"}}>—</span>}
                  </td>
                  <td style={{padding:"7px 8px"}}>
                    {canEdit?(
                      <select value={m.status} onChange={e=>updateMat(m.id,"status",e.target.value)} style={{fontSize:11,padding:"2px 5px",borderRadius:99,background:mc.bg,color:mc.text,border:`0.5px solid ${mc.border}`,cursor:"pointer"}}>
                        {MAT_STATUSES.map(s=><option key={s}>{s}</option>)}
                      </select>
                    ):<span style={{fontSize:11,padding:"2px 8px",borderRadius:99,background:mc.bg,color:mc.text,border:`0.5px solid ${mc.border}`}}>{m.status}</span>}
                  </td>
                  <td style={{padding:"7px 8px",color:"var(--color-text-secondary)"}}>{m.notes||"—"}</td>
                  <td style={{padding:"7px 8px"}}>{canEdit&&<button onClick={()=>removeMat(m.id)} style={{fontSize:11,color:"var(--color-text-tertiary)",background:"none",border:"none",cursor:"pointer"}}>×</button>}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>
  );
}

// ── Debrief Tab ───────────────────────────────────────────────────────────────
function DebriefTab({ev, onUpdate, currentUser}){
  const db = ev.debrief || { locked:false, completedDate:"", attendance:"", rating:0, entries:FEEDBACK_PROMPTS.map((p,i)=>({id:i+1,prompt:p,response:""})), additionalNotes:"", author:"", authorDate:"" };
  const isResponsible = currentUser === ev.team.mainResponsible || currentUser === "Natasha";
  const canWrite = isResponsible && !db.locked;
  const eventPast = daysLeft(ev.date) !== null && daysLeft(ev.date) < 0;

  function updDb(key, val){ onUpdate({...ev, debrief:{...db,[key]:val}}); }
  function setEntry(id, val){ updDb("entries", db.entries.map(e=>e.id===id?{...e,response:val}:e)); }
  function lock(){
    if(!window.confirm("Lock this debrief? It will become read-only.")) return;
    onUpdate({...ev, debrief:{...db, locked:true, author:currentUser, authorDate:new Date().toISOString().slice(0,10)}});
  }

  const filled = db.entries.filter(e=>e.response.trim()).length;
  const pctFilled = Math.round(filled/db.entries.length*100);

  if (!eventPast && ev.status !== "Completed") {
    return (
      <div style={{textAlign:"center",padding:"2rem",color:"var(--color-text-tertiary)"}}>
        <div style={{fontSize:28,marginBottom:8}}>📋</div>
        <div style={{fontSize:13,color:"var(--color-text-secondary)",marginBottom:4}}>Post-event debrief</div>
        <div style={{fontSize:12}}>This section will be available once the event has taken place or is marked as Completed.</div>
      </div>
    );
  }

  if (!isResponsible && !db.locked) {
    return (
      <div style={{textAlign:"center",padding:"2rem",color:"var(--color-text-tertiary)"}}>
        <div style={{fontSize:28,marginBottom:8}}>🔒</div>
        <div style={{fontSize:12}}>Only <strong>{ev.team.mainResponsible}</strong> can write the debrief for this event.</div>
      </div>
    );
  }

  return (
    <div style={{maxWidth:680}}>
      {/* Header strip */}
      <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:"1rem",padding:"10px 14px",background:db.locked?"var(--color-background-secondary)":"#EAF3DE",border:`0.5px solid ${db.locked?"var(--color-border-tertiary)":"#639922"}`,borderRadius:"var(--border-radius-lg)"}}>
        <div style={{display:"flex",alignItems:"center",gap:10}}>
          <span style={{fontSize:13,fontWeight:500,color:db.locked?"var(--color-text-secondary)":"#3B6D11"}}>
            {db.locked ? `✓ Debrief completed · ${db.author} · ${fmtFull(db.authorDate)}` : "✏️ Debrief in progress"}
          </span>
          {!db.locked && <span style={{fontSize:11,color:"var(--color-text-tertiary)"}}>{filled}/{db.entries.length} sections filled</span>}
        </div>
        {canWrite && (
          <button onClick={lock} style={{fontSize:11,padding:"4px 12px",cursor:"pointer",background:"#3B6D11",color:"#fff",border:"none",borderRadius:"var(--border-radius-md)"}}>
            Lock & finalize
          </button>
        )}
      </div>

      {/* Meta fields */}
      <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:10,marginBottom:"1.25rem"}}>
        <div>
          <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Event date completed</div>
          {canWrite ? <input type="date" value={db.completedDate} onChange={e=>updDb("completedDate",e.target.value)} style={{fontSize:12,padding:"5px 7px",width:"100%",boxSizing:"border-box"}}/> : <div style={{fontSize:12}}>{fmtFull(db.completedDate)||"—"}</div>}
        </div>
        <div>
          <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Attendance (approx.)</div>
          {canWrite ? <input value={db.attendance} onChange={e=>updDb("attendance",e.target.value)} placeholder="e.g. 120 families" style={{fontSize:12,padding:"5px 7px",width:"100%",boxSizing:"border-box"}}/> : <div style={{fontSize:12}}>{db.attendance||"—"}</div>}
        </div>
        <div>
          <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Overall rating</div>
          <div style={{display:"flex",gap:4,alignItems:"center"}}>
            {[1,2,3,4,5].map(n=>(
              <button key={n} onClick={()=>canWrite&&updDb("rating",n)} style={{fontSize:18,background:"none",border:"none",cursor:canWrite?"pointer":"default",opacity:n<=db.rating?1:0.25,padding:"0 1px"}}>★</button>
            ))}
          </div>
        </div>
      </div>

      {/* Progress bar */}
      {!db.locked && (
        <div style={{marginBottom:"1.25rem"}}>
          <div style={{height:4,background:"var(--color-border-tertiary)",borderRadius:2,overflow:"hidden"}}>
            <div style={{width:`${pctFilled}%`,height:"100%",background:"#639922",borderRadius:2,transition:"width 0.3s"}}/>
          </div>
        </div>
      )}

      {/* Prompt entries */}
      <div style={{display:"flex",flexDirection:"column",gap:12,marginBottom:"1.25rem"}}>
        {db.entries.map((e,i)=>(
          <div key={e.id} style={{border:"0.5px solid var(--color-border-tertiary)",borderRadius:"var(--border-radius-md)",padding:"10px 12px",background:e.response.trim()?"var(--color-background-primary)":"var(--color-background-secondary)"}}>
            <div style={{fontSize:11,fontWeight:500,color:"var(--color-text-secondary)",marginBottom:5}}>{i+1}. {e.prompt}</div>
            {canWrite ? (
              <textarea value={e.response} onChange={ev=>setEntry(e.id,ev.target.value)} rows={3} placeholder="Write here…" style={{fontSize:13,width:"100%",resize:"vertical",padding:"6px 8px",boxSizing:"border-box",border:"0.5px solid var(--color-border-secondary)",borderRadius:"var(--border-radius-md)"}}/>
            ) : (
              <div style={{fontSize:13,color:e.response?"var(--color-text-primary)":"var(--color-text-tertiary)",lineHeight:1.6,whiteSpace:"pre-wrap"}}>{e.response||"—"}</div>
            )}
          </div>
        ))}
      </div>

      {/* Additional notes */}
      <div style={{border:"0.5px solid var(--color-border-tertiary)",borderRadius:"var(--border-radius-md)",padding:"10px 12px",background:"var(--color-background-secondary)"}}>
        <div style={{fontSize:11,fontWeight:500,color:"var(--color-text-secondary)",marginBottom:5}}>Additional notes / attachments</div>
        {canWrite ? (
          <textarea value={db.additionalNotes} onChange={e=>updDb("additionalNotes",e.target.value)} rows={4} placeholder="Any additional observations, links to photos, external documents, follow-up actions…" style={{fontSize:13,width:"100%",resize:"vertical",padding:"6px 8px",boxSizing:"border-box"}}/>
        ) : (
          <div style={{fontSize:13,color:db.additionalNotes?"var(--color-text-primary)":"var(--color-text-tertiary)",lineHeight:1.6,whiteSpace:"pre-wrap"}}>{db.additionalNotes||"—"}</div>
        )}
      </div>
    </div>
  );
}
function MilestonesTab({ev,onUpdate,canEdit}){
  const [form,setForm]=useState({type:MILESTONE_TYPES[0],date:"",responsible:"",customName:"",notes:""});
  function addMs(){if(!form.date)return;onUpdate({...ev,milestones:[...ev.milestones,{id:Date.now(),...form}]});setForm({type:MILESTONE_TYPES[0],date:"",responsible:"",customName:"",notes:""});}
  function removeMs(id){onUpdate({...ev,milestones:ev.milestones.filter(m=>m.id!==id)});}
  const sorted=[...ev.milestones].sort((a,b)=>a.date.localeCompare(b.date));
  return (
    <div>
      {canEdit&&(
        <div style={{border:"0.5px solid var(--color-border-secondary)",borderRadius:"var(--border-radius-lg)",padding:"0.75rem",marginBottom:"1rem",background:"var(--color-background-secondary)"}}>
          <div style={{fontSize:12,fontWeight:500,color:"var(--color-text-secondary)",marginBottom:8}}>Add milestone</div>
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 1fr",gap:8,marginBottom:8}}>
            <select value={form.type} onChange={e=>setForm(f=>({...f,type:e.target.value}))} style={{fontSize:12,padding:"5px 7px"}}>
              {MILESTONE_TYPES.map(t=><option key={t}>{t}</option>)}
            </select>
            <input type="date" value={form.date} onChange={e=>setForm(f=>({...f,date:e.target.value}))} style={{fontSize:12,padding:"5px 7px"}}/>
            <input value={form.notes} onChange={e=>setForm(f=>({...f,notes:e.target.value}))} placeholder="Notes (optional)" style={{fontSize:12,padding:"5px 7px"}}/>
          </div>
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8,marginBottom:8}}>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Responsible dept.</div>
              <select value={form.responsible} onChange={e=>setForm(f=>({...f,responsible:e.target.value,customName:""}))} style={{fontSize:12,padding:"5px 7px",width:"100%"}}>
                <option value="">— select —</option>
                {DEPARTMENTS.map(d=><option key={d}>{d}</option>)}
              </select>
            </div>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>or custom name</div>
              <input value={form.customName} onChange={e=>setForm(f=>({...f,customName:e.target.value,responsible:""}))} placeholder="Type name…" style={{fontSize:12,padding:"5px 7px",width:"100%",boxSizing:"border-box"}}/>
            </div>
          </div>
          <button onClick={addMs} style={{fontSize:12,padding:"6px 14px",cursor:"pointer",background:"var(--color-background-info)",color:"var(--color-text-info)",border:"0.5px solid var(--color-border-info)",borderRadius:"var(--border-radius-md)"}}>Add milestone</button>
        </div>
      )}
      {sorted.length===0?(
        <div style={{fontSize:12,color:"var(--color-text-tertiary)",textAlign:"center",padding:"1.5rem"}}>No milestones added yet.</div>
      ):(
        <div style={{display:"flex",flexDirection:"column",gap:0}}>
          {sorted.map((m,i)=>{
            const dl=daysLeft(m.date);
            const past=dl!==null&&dl<0;
            const resp=m.customName||m.responsible;
            return(
              <div key={m.id} style={{display:"flex",gap:12,alignItems:"flex-start",padding:"10px 0",borderBottom:"0.5px solid var(--color-border-tertiary)"}}>
                <div style={{display:"flex",flexDirection:"column",alignItems:"center",paddingTop:3}}>
                  <div style={{width:10,height:10,borderRadius:"50%",background:past?"var(--color-border-tertiary)":ev.color,flexShrink:0}}/>
                  {i<sorted.length-1&&<div style={{width:1,height:20,background:"var(--color-border-tertiary)",marginTop:3}}/>}
                </div>
                <div style={{flex:1,minWidth:0}}>
                  <div style={{display:"flex",gap:8,alignItems:"center",flexWrap:"wrap",marginBottom:2}}>
                    <span style={{fontSize:12,fontWeight:500,color:past?"var(--color-text-tertiary)":"var(--color-text-primary)"}}>{m.type}</span>
                    <span style={{fontSize:11,color:"var(--color-text-secondary)"}}>{fmtFull(m.date)}</span>
                    {!past&&dl!==null&&<span style={{fontSize:11,padding:"1px 6px",borderRadius:99,background:dl<=7?"#FAEEDA":"var(--color-background-secondary)",color:dl<=7?"#854F0B":"var(--color-text-secondary)"}}>{dl===0?"Today":`${dl}d`}</span>}
                    {past&&<span style={{fontSize:11,color:"var(--color-text-tertiary)"}}>Past</span>}
                    {resp&&<span style={{fontSize:11,padding:"1px 7px",borderRadius:99,background:"var(--color-background-secondary)",color:"var(--color-text-secondary)",border:"0.5px solid var(--color-border-tertiary)"}}>{resp}</span>}
                  </div>
                  {m.notes&&<div style={{fontSize:12,color:"var(--color-text-secondary)"}}>{m.notes}</div>}
                </div>
                {canEdit&&<button onClick={()=>removeMs(m.id)} style={{fontSize:11,color:"var(--color-text-tertiary)",background:"none",border:"none",cursor:"pointer",flexShrink:0}}>×</button>}
              </div>
            );
          })}
        </div>
      )}
    </div>
  );
}
