  const TABS=[["levels","Levels"],["team","Team"],["logistics","Logistics"],["materials","Materials"],["milestones","Milestones"],["debrief","Debrief"]];
  return (
    <div style={{borderTop:"1.5px solid var(--color-border-secondary)",background:"var(--color-background-primary)"}}>
      <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"0.75rem 1.25rem",borderBottom:"0.5px solid var(--color-border-tertiary)"}}>
        <div style={{display:"flex",alignItems:"center",gap:12}}>
          <div style={{width:4,height:32,borderRadius:2,background:ev.color}}/>
          <div>
            <div style={{fontSize:14,fontWeight:600,color:"var(--color-text-primary)"}}>{ev.title}</div>
            <div style={{fontSize:12,color:"var(--color-text-secondary)"}}>{fmtFull(ev.date)} · {daysLeft(ev.date)>=0?`${daysLeft(ev.date)} days away`:"Past event"}</div>
          </div>
        </div>
        <div style={{display:"flex",alignItems:"center",gap:8}}>
          {canEdit&&(
            <div style={{display:"flex",gap:4,flexWrap:"wrap"}}>
              {STATUSES.map(s=>{const sc=STATUS_COLORS[s];return(
                <button key={s} onClick={()=>onUpdate({...ev,status:s})} style={{fontSize:11,padding:"3px 8px",borderRadius:99,border:`0.5px solid ${sc.border}`,background:ev.status===s?sc.bg:"transparent",color:sc.text,cursor:"pointer",fontWeight:ev.status===s?500:400}}>{s}</button>
              );})}
            </div>
          )}
          <button onClick={onClose} style={{fontSize:16,color:"var(--color-text-tertiary)",background:"none",border:"none",cursor:"pointer"}}>×</button>
        </div>
      </div>
      <div style={{display:"flex",borderBottom:"0.5px solid var(--color-border-tertiary)",padding:"0 1.25rem",background:"var(--color-background-secondary)"}}>
        {TABS.map(([t,l])=>(
          <button key={t} onClick={()=>setActiveTab(t)} style={{fontSize:12,padding:"8px 14px",border:"none",borderBottom:activeTab===t?"2px solid var(--color-border-info)":"2px solid transparent",background:"transparent",color:activeTab===t?"var(--color-text-info)":"var(--color-text-secondary)",cursor:"pointer",fontWeight:activeTab===t?500:400,whiteSpace:"nowrap"}}>{l}</button>
        ))}
      </div>
      <div style={{padding:"1rem 1.25rem",maxHeight:400,overflowY:"auto"}}>
        {activeTab==="levels"    &&<LevelsTab ev={ev} onUpdate={onUpdate} canEdit={canEdit}/>}
        {activeTab==="team"      &&<TeamTab ev={ev} onUpdate={onUpdate} canEdit={canEdit}/>}
        {activeTab==="logistics" &&<LogisticsTab ev={ev} onUpdate={onUpdate} canEdit={canEdit}/>}
        {activeTab==="materials" &&<MaterialsTab ev={ev} onUpdate={onUpdate} canEdit={canEdit} currentUser={currentUser}/>}
        {activeTab==="milestones"&&<MilestonesTab ev={ev} onUpdate={onUpdate} canEdit={canEdit}/>}
        {activeTab==="debrief"   &&<DebriefTab ev={ev} onUpdate={onUpdate} currentUser={currentUser}/>}
      </div>
    </div>
  );
}

// ── Levels Tab ────────────────────────────────────────────────────────────────
function LevelsTab({ev,onUpdate,canEdit}){
  function setLevel(level,key,val){const clone=JSON.parse(JSON.stringify(ev));clone.levels[level][key]=val;onUpdate(clone);}
  return (
    <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:12}}>
      {LEVELS.map(l=>{
        const d=ev.levels[l];
        const ac=l==="Early Years"?"#BA7517":l==="Preschool"?"#D85A30":"#378ADD";
        return (
          <div key={l} style={{border:`0.5px solid ${d.active?ac:"var(--color-border-tertiary)"}`,borderRadius:"var(--border-radius-lg)",padding:"0.875rem",background:d.active?ac+"11":"var(--color-background-secondary)"}}>
            <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:10}}>
              <input type="checkbox" checked={d.active} disabled={!canEdit} onChange={e=>setLevel(l,"active",e.target.checked)}/>
              <span style={{fontWeight:500,color:d.active?ac:"var(--color-text-secondary)",fontSize:13}}>{l}</span>
            </div>
            <div style={{marginBottom:8}}>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Responsible</div>
              {canEdit?(
                <select value={d.responsible} onChange={e=>setLevel(l,"responsible",e.target.value)} style={{fontSize:12,width:"100%",padding:"4px 6px"}}>
                  <option value="">— assign —</option>
                  {USERS.map(u=><option key={u}>{u}</option>)}
                </select>
              ):<div style={{fontSize:12}}>{d.responsible||"—"}</div>}
            </div>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Notes</div>
              {canEdit?(
                <textarea value={d.notes} onChange={e=>setLevel(l,"notes",e.target.value)} rows={3} placeholder="Notes…" style={{fontSize:12,width:"100%",resize:"vertical",padding:"5px 7px",boxSizing:"border-box"}}/>
              ):<div style={{fontSize:12,color:"var(--color-text-secondary)",lineHeight:1.5}}>{d.notes||"—"}</div>}
            </div>
          </div>
        );
      })}
    </div>
  );
}

// ── Team Tab ──────────────────────────────────────────────────────────────────
const ALL_ROLES = ["Natasha","Academic Coordinator","Wellbeing Coordinator","Preschool Coordinator","Sports Coordinator",...DEPARTMENTS,"Other"];

function TeamTab({ev,onUpdate,canEdit}){
  const team = ev.team;
  const [newMember, setNewMember] = useState({ role:"", customName:"" });

  function setMain(field, val){
    onUpdate({...ev, team:{...team, mainResponsible: field==="role"?val:team.mainResponsible, mainResponsibleCustom: field==="custom"?val:(val==="Other"?team.mainResponsibleCustom:"") }});
  }
  function addMember(){
    const name = newMember.role==="Other" ? newMember.customName.trim() : newMember.role;
    if (!name) return;
    if (team.members?.find(m=>m.name===name)) return;
    onUpdate({...ev, team:{...team, members:[...(team.members||[]), { name, role: newMember.role==="Other"?"Custom":newMember.role }]}});
    setNewMember({ role:"", customName:"" });
  }
  function removeMember(name){ onUpdate({...ev, team:{...team, members:(team.members||[]).filter(m=>m.name!==name)}}); }

  const mainDisplay = team.mainResponsible==="Other" ? (team.mainResponsibleCustom||"Other") : team.mainResponsible;

  return (
    <div style={{maxWidth:560}}>
      {/* Main responsible */}
      <div style={{marginBottom:"1.25rem",border:"0.5px solid var(--color-border-tertiary)",borderRadius:"var(--border-radius-lg)",padding:"12px 14px",background:"var(--color-background-secondary)"}}>
        <div style={{fontSize:12,fontWeight:600,color:"var(--color-text-primary)",marginBottom:8}}>Main Responsible</div>
        {canEdit ? (
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8}}>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Role / Department</div>
              <select value={team.mainResponsible||""} onChange={e=>setMain("role",e.target.value)} style={{fontSize:12,padding:"5px 7px",width:"100%"}}>
                <option value="">— select —</option>
                {ALL_ROLES.map(r=><option key={r}>{r}</option>)}
              </select>
            </div>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Name (optional / if Other)</div>
              <input value={team.mainResponsibleCustom||""} onChange={e=>setMain("custom",e.target.value)} placeholder="e.g. Ms. García" style={{fontSize:12,padding:"5px 7px",width:"100%",boxSizing:"border-box"}}/>
            </div>
          </div>
        ) : (
