}

// ── Logistics Tab ─────────────────────────────────────────────────────────────
function LogisticsTab({ev,onUpdate,canEdit}){
  const [newSpace,setNewSpace]=useState("");
  const [newMaint,setNewMaint]=useState("");
  const lg=ev.logistics;
  function updLg(key,val){onUpdate({...ev,logistics:{...lg,[key]:val}});}
  function setSpaceField(id,field,val){updLg("spaces",lg.spaces.map(s=>s.id===id?{...s,[field]:val}:s));}
  function addSpace(){if(!newSpace.trim())return;updLg("spaces",[...lg.spaces,{id:Date.now(),name:newSpace.trim(),description:"",assignee:emptyAssignee()}]);setNewSpace("");}
  function removeSpace(id){updLg("spaces",lg.spaces.filter(s=>s.id!==id));}
  function toggleMaint(id){updLg("maintenance",lg.maintenance.map(m=>m.id===id?{...m,done:!m.done}:m));}
  function setMaintAssignee(id,val){updLg("maintenance",lg.maintenance.map(m=>m.id===id?{...m,assignee:val}:m));}
  function addMaint(){if(!newMaint.trim())return;updLg("maintenance",[...lg.maintenance,{id:Date.now(),name:newMaint.trim(),fixed:false,done:false,assignee:emptyAssignee()}]);setNewMaint("");}
  function removeMaint(id){updLg("maintenance",lg.maintenance.filter(m=>m.id!==id));}
  function setQuick(key,field,val){updLg(key,{...lg[key],[field]:val});}
  const maintDone=lg.maintenance.filter(m=>m.done).length;

  return (
    <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:"1.5rem"}}>
      {/* Spaces */}
      <div>
        <div style={{fontSize:12,fontWeight:600,color:"var(--color-text-primary)",marginBottom:8,textTransform:"uppercase",letterSpacing:"0.04em"}}>Venue & Spaces</div>
        <div style={{display:"flex",flexDirection:"column",gap:8}}>
          {lg.spaces.map(s=>(
            <div key={s.id} style={{border:"0.5px solid var(--color-border-tertiary)",borderRadius:"var(--border-radius-md)",padding:"8px 10px",background:"var(--color-background-secondary)"}}>
              <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:6}}>
                <span style={{fontSize:12,fontWeight:500,color:"var(--color-text-primary)"}}>{s.name}</span>
                <div style={{display:"flex",alignItems:"center",gap:6}}>
                  <AssigneeWidget value={s.assignee} onChange={val=>setSpaceField(s.id,"assignee",val)} canEdit={canEdit}/>
                  {canEdit&&!DEFAULT_SPACES.includes(s.name)&&<button onClick={()=>removeSpace(s.id)} style={{fontSize:11,color:"var(--color-text-tertiary)",background:"none",border:"none",cursor:"pointer"}}>×</button>}
                </div>
              </div>
              {canEdit?(
                <textarea value={s.description} onChange={e=>setSpaceField(s.id,"description",e.target.value)} rows={2} placeholder={`Describe ${s.name} setup…`} style={{fontSize:12,width:"100%",resize:"vertical",padding:"4px 6px",boxSizing:"border-box"}}/>
              ):<div style={{fontSize:12,color:s.description?"var(--color-text-secondary)":"var(--color-text-tertiary)",lineHeight:1.5}}>{s.description||"No description yet."}</div>}
            </div>
          ))}
        </div>
        {canEdit&&(
          <div style={{display:"flex",gap:6,marginTop:8}}>
            <input value={newSpace} onChange={e=>setNewSpace(e.target.value)} onKeyDown={e=>e.key==="Enter"&&addSpace()} placeholder="Add space…" style={{flex:1,fontSize:12,padding:"5px 7px"}}/>
            <button onClick={addSpace} style={{fontSize:12,padding:"5px 9px",cursor:"pointer"}}>+</button>
          </div>
        )}
      </div>

      <div>
        {/* Maintenance */}
        <div style={{marginBottom:"1.25rem"}}>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:8}}>
            <div style={{fontSize:12,fontWeight:600,color:"var(--color-text-primary)",textTransform:"uppercase",letterSpacing:"0.04em"}}>Maintenance</div>
            <span style={{fontSize:11,color:"var(--color-text-secondary)"}}>{maintDone}/{lg.maintenance.length}</span>
          </div>
          <div style={{display:"flex",flexDirection:"column",gap:6,maxHeight:200,overflowY:"auto"}}>
            {lg.maintenance.map(m=>(
              <div key={m.id} style={{display:"flex",alignItems:"center",gap:8,padding:"5px 0",borderBottom:"0.5px solid var(--color-border-tertiary)"}}>
                <input type="checkbox" checked={m.done} disabled={!canEdit} onChange={()=>toggleMaint(m.id)} style={{flexShrink:0}}/>
                <span style={{flex:1,fontSize:12,color:m.done?"var(--color-text-tertiary)":"var(--color-text-primary)",textDecoration:m.done?"line-through":"none"}}>{m.name}</span>
                <AssigneeWidget value={m.assignee} onChange={val=>setMaintAssignee(m.id,val)} canEdit={canEdit}/>
                {canEdit&&!m.fixed&&<button onClick={()=>removeMaint(m.id)} style={{fontSize:11,color:"var(--color-text-tertiary)",background:"none",border:"none",cursor:"pointer",padding:0}}>×</button>}
              </div>
            ))}
          </div>
          {canEdit&&(
            <div style={{display:"flex",gap:6,marginTop:8}}>
              <input value={newMaint} onChange={e=>setNewMaint(e.target.value)} onKeyDown={e=>e.key==="Enter"&&addMaint()} placeholder="Add item…" style={{flex:1,fontSize:12,padding:"5px 7px"}}/>
              <button onClick={addMaint} style={{fontSize:12,padding:"5px 9px",cursor:"pointer"}}>+</button>
            </div>
          )}
        </div>

        {/* Coordinate with */}
        <div style={{marginBottom:"1.25rem"}}>
          <div style={{fontSize:12,fontWeight:600,color:"var(--color-text-primary)",marginBottom:8,textTransform:"uppercase",letterSpacing:"0.04em"}}>Coordinate with</div>
          {[["cafeteria","Cafeteria"],["parking","Parking"],["externalSports","External Sports"]].map(([key,label])=>(
            <div key={key} style={{border:"0.5px solid var(--color-border-tertiary)",borderRadius:"var(--border-radius-md)",padding:"8px 10px",marginBottom:6,background:lg[key].needed?"var(--color-background-info)":"var(--color-background-secondary)"}}>
              <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:lg[key].needed?6:0}}>
                <input type="checkbox" checked={lg[key].needed} disabled={!canEdit} onChange={e=>setQuick(key,"needed",e.target.checked)}/>
                <span style={{fontSize:12,fontWeight:500,color:lg[key].needed?"var(--color-text-info)":"var(--color-text-secondary)"}}>{label}</span>
                {lg[key].needed&&<div style={{marginLeft:"auto"}}><AssigneeWidget value={lg[key].assignee} onChange={val=>setQuick(key,"assignee",val)} canEdit={canEdit}/></div>}
              </div>
              {lg[key].needed&&(canEdit?(
                <input value={lg[key].notes} onChange={e=>setQuick(key,"notes",e.target.value)} placeholder="Notes…" style={{fontSize:12,width:"100%",padding:"4px 6px",boxSizing:"border-box"}}/>
              ):<div style={{fontSize:12,color:"var(--color-text-secondary)"}}>{lg[key].notes||"—"}</div>)}
            </div>
          ))}
        </div>

        {/* Comments */}
        <div>
          <div style={{fontSize:12,fontWeight:600,color:"var(--color-text-primary)",marginBottom:6,textTransform:"uppercase",letterSpacing:"0.04em"}}>Comments & Observations</div>
          {canEdit?(
            <textarea value={lg.comments} onChange={e=>updLg("comments",e.target.value)} rows={4} placeholder="General logistics notes, observations, pending decisions…" style={{fontSize:12,width:"100%",resize:"vertical",padding:"6px 8px",boxSizing:"border-box"}}/>
          ):<div style={{fontSize:12,color:lg.comments?"var(--color-text-secondary)":"var(--color-text-tertiary)",lineHeight:1.5}}>{lg.comments||"No comments yet."}</div>}
        </div>
      </div>
    </div>
  );
}

// ── Materials Tab ─────────────────────────────────────────────────────────────
function MaterialsTab({ev,onUpdate,canEdit,currentUser}){
  const [form,setForm]=useState({item:"",qty:"",unit:"",responsible:"",customName:"",dueDate:"",status:"To Do",notes:""});
  function addMat(){
    if(!form.item.trim())return;
    onUpdate({...ev,materials:[...ev.materials,{id:Date.now(),...form,addedBy:currentUser,addedDate:new Date().toISOString().slice(0,10)}]});
    setForm({item:"",qty:"",unit:"",responsible:"",customName:"",dueDate:"",status:"To Do",notes:""});
  }
  function updateMat(id,key,val){onUpdate({...ev,materials:ev.materials.map(m=>m.id===id?{...m,[key]:val}:m)});}
  function updateMatAssignee(id,val){onUpdate({...ev,materials:ev.materials.map(m=>m.id===id?{...m,...val}:m)});}
  function removeMat(id){onUpdate({...ev,materials:ev.materials.filter(m=>m.id!==id)});}

  return (
    <div>
      <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:8,marginBottom:"1rem"}}>
        {MAT_STATUSES.map(s=>{const mc=MAT_COLORS[s];const count=ev.materials.filter(m=>m.status===s).length;return(
          <div key={s} style={{padding:"10px 12px",background:mc.bg,border:`0.5px solid ${mc.border}`,borderRadius:"var(--border-radius-md)",textAlign:"center"}}>
            <div style={{fontSize:20,fontWeight:500,color:mc.text}}>{count}</div>
            <div style={{fontSize:11,color:mc.text}}>{s}</div>
          </div>
        );})}
      </div>

      {canEdit&&(
        <div style={{border:"0.5px solid var(--color-border-secondary)",borderRadius:"var(--border-radius-lg)",padding:"0.75rem",marginBottom:"1rem",background:"var(--color-background-secondary)"}}>
          <div style={{fontSize:12,fontWeight:500,color:"var(--color-text-secondary)",marginBottom:8}}>Add requisition</div>
          <div style={{display:"grid",gridTemplateColumns:"2fr 1fr 1fr",gap:8,marginBottom:8}}>
            <input value={form.item} onChange={e=>setForm(f=>({...f,item:e.target.value}))} placeholder="Item / material *" style={{fontSize:12,padding:"5px 7px"}}/>
            <input value={form.qty} onChange={e=>setForm(f=>({...f,qty:e.target.value}))} placeholder="Qty" style={{fontSize:12,padding:"5px 7px"}}/>
            <input value={form.unit} onChange={e=>setForm(f=>({...f,unit:e.target.value}))} placeholder="Unit (pcs, sets…)" style={{fontSize:12,padding:"5px 7px"}}/>
          </div>
          <div style={{display:"grid",gridTemplateColumns:"1fr 1fr 2fr",gap:8,marginBottom:8}}>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Responsible dept.</div>
              <select value={form.responsible} onChange={e=>setForm(f=>({...f,responsible:e.target.value,customName:""}))} style={{fontSize:12,padding:"5px 7px",width:"100%"}}>
                <option value="">— select —</option>
                {DEPARTMENTS.map(d=><option key={d}>{d}</option>)}
              </select>
            </div>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>or custom name</div>
              <input value={form.customName} onChange={e=>setForm(f=>({...f,customName:e.target.value,responsible:""}))} placeholder="Type name…" style={{fontSize:12,padding:"5px 7px",width:"100%",boxSizing:"border-box"}}/>
            </div>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Due date</div>
              <input type="date" value={form.dueDate} onChange={e=>setForm(f=>({...f,dueDate:e.target.value}))} style={{fontSize:12,padding:"5px 7px",width:"100%",boxSizing:"border-box"}}/>
            </div>
          </div>
          <div style={{display:"grid",gridTemplateColumns:"1fr 2fr",gap:8,marginBottom:8}}>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Status</div>
              <div style={{display:"flex",gap:4}}>
                {MAT_STATUSES.map(s=>{const c=MAT_COLORS[s];return(<button key={s} onClick={()=>setForm(f=>({...f,status:s}))} style={{fontSize:11,padding:"3px 8px",borderRadius:99,border:`0.5px solid ${c.border}`,background:form.status===s?c.bg:"transparent",color:c.text,cursor:"pointer"}}>{s}</button>);})}
              </div>
            </div>
            <div>
              <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:3}}>Notes</div>
              <input value={form.notes} onChange={e=>setForm(f=>({...f,notes:e.target.value}))} placeholder="Optional" style={{fontSize:12,padding:"5px 7px",width:"100%",boxSizing:"border-box"}}/>
            </div>
          </div>
          <button onClick={addMat} style={{fontSize:12,padding:"6px 14px",cursor:"pointer",background:"var(--color-background-info)",color:"var(--color-text-info)",border:"0.5px solid var(--color-border-info)",borderRadius:"var(--border-radius-md)"}}>Add item</button>
        </div>
      )}

      {ev.materials.length===0?(
        <div style={{fontSize:12,color:"var(--color-text-tertiary)",textAlign:"center",padding:"1.5rem"}}>No materials added yet.</div>
      ):(
        <table style={{width:"100%",borderCollapse:"collapse",fontSize:12}}>
          <thead>
            <tr style={{borderBottom:"0.5px solid var(--color-border-tertiary)"}}>
              {["Item","Qty","Responsible","Due","Status","Notes",""].map((h,i)=>(
                <th key={i} style={{padding:"6px 8px",textAlign:"left",fontWeight:500,color:"var(--color-text-tertiary)",fontSize:11,whiteSpace:"nowrap"}}>{h}</th>
              ))}
