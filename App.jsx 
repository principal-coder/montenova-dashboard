const FIXED_MAINTENANCE = ["Sound system & AV setup","Microphones & stands","Lighting","Stage / risers","Chair setup & distribution","Tables","Cleaning before event","Cleaning after event","Trash & waste management","Security / access control","Signage & banners","Electrical / extension cords"];
const DEFAULT_SPACES = ["Venue","Stage","Chairs distribution","Decoration","AV / Sound","Entrance & reception"];
const MILESTONE_TYPES = ["Parent communication","Rehearsal","Materials deadline","Setup day","Dry run","Other"];
const FEEDBACK_PROMPTS = [
