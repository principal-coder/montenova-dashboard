];

const EVENTS = [
  { id:1, title:"Music & Arts Festival",                  date:"2026-05-28", color:"#D4537E" },
  { id:2, title:"Teachers' Day",                          date:"2026-05-15", color:"#378ADD" },
  { id:3, title:"Fathers' Day",                           date:"2026-06-19", color:"#1D9E75" },
  { id:4, title:"Kinder Graduation Ceremony",             date:"2026-06-26", color:"#639922" },
  { id:5, title:"5th Grade Graduation Ceremony",          date:"2026-06-26", color:"#BA7517" },
  { id:6, title:"End of the Year Ceremony",               date:"2026-07-03", color:"#7F77DD" },
  { id:7, title:"Parents Association Recognition Dinner", date:"2026-07-10", color:"#D85A30" },
];

function emptyAssignee() { return { responsible:"", customName:"", dueDate:"", status:"To Do" }; }

function makeEvent(ev) {
  return {
    ...ev, status:"Not started",
    levels:{ "Early Years":{ active:false, responsible:"", notes:"" }, "Preschool":{ active:false, responsible:"", notes:"" }, "Elementary":{ active:false, responsible:"", notes:"" } },
    team:{ mainResponsible:"Natasha", coordinators:[] },
    logistics:{
      spaces: DEFAULT_SPACES.map((name,i)=>({ id:i+1, name, description:"", assignee:emptyAssignee() })),
      maintenance: FIXED_MAINTENANCE.map((name,i)=>({ id:i+1, name, fixed:true, done:false, assignee:emptyAssignee() })),
      cafeteria:{ needed:false, notes:"", assignee:emptyAssignee() },
      parking:{ needed:false, notes:"", assignee:emptyAssignee() },
      externalSports:{ needed:false, notes:"", assignee:emptyAssignee() },
      comments:"",
    },
    materials:[],
    milestones:[],
    debrief:{
      locked: false,
      completedDate: "",
      attendance: "",
      rating: 0,
      entries: FEEDBACK_PROMPTS.map((prompt,i)=>({ id:i+1, prompt, response:"" })),
      additionalNotes: "",
      author: "",
      authorDate: "",
    },
  };
}

function fmt(d) {
  if (!d) return "—";
  const [y,m,day] = d.split("-");
  const mo=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${mo[+m-1]} ${+day}`;
}
function fmtFull(d) {
  if (!d) return "—";
  const [y,m,day] = d.split("-");
  const mo=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${mo[+m-1]} ${+day}, ${y}`;
}
function daysLeft(d) {
  if (!d) return null;
  return Math.ceil((new Date(d)-new Date())/86400000);
}
function pct(done,total){ return total?Math.round(done/total*100):0; }

// ── Assignee widget ──────────────────────────────────────────────────────────
function AssigneeWidget({ value, onChange, canEdit, compact=false }) {
  const [open, setOpen] = useState(false);
  const display = value.customName || value.responsible;
  const sc = MAT_COLORS[value.status]||MAT_COLORS["To Do"];

  if (!canEdit) {
    if (!display) return null;
    return (
      <div style={{display:"flex",gap:5,alignItems:"center",flexWrap:"wrap"}}>
        <span style={{fontSize:11,padding:"1px 7px",borderRadius:99,background:"var(--color-background-secondary)",color:"var(--color-text-secondary)",border:"0.5px solid var(--color-border-tertiary)"}}>{display}</span>
        {value.dueDate&&<span style={{fontSize:11,color:"var(--color-text-tertiary)"}}>{fmt(value.dueDate)}</span>}
        <span style={{fontSize:11,padding:"1px 7px",borderRadius:99,background:sc.bg,color:sc.text,border:`0.5px solid ${sc.border}`}}>{value.status}</span>
      </div>
    );
  }

  return (
    <div style={{position:"relative"}}>
      <button onClick={()=>setOpen(o=>!o)} style={{fontSize:11,padding:"2px 8px",borderRadius:99,border:"0.5px solid var(--color-border-secondary)",background:display?"var(--color-background-info)":"var(--color-background-secondary)",color:display?"var(--color-text-info)":"var(--color-text-tertiary)",cursor:"pointer",whiteSpace:"nowrap"}}>
        {display ? `${display}${value.dueDate?" · "+fmt(value.dueDate):""}` : "+ assign"}
      </button>
      {open && (
        <div style={{position:"absolute",zIndex:100,top:"calc(100% + 4px)",left:0,background:"var(--color-background-primary)",border:"0.5px solid var(--color-border-secondary)",borderRadius:"var(--border-radius-lg)",padding:"10px",minWidth:220,boxShadow:"0 4px 16px rgba(0,0,0,0.12)"}}>
          <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:4}}>Department / Role</div>
          <select value={value.responsible} onChange={e=>onChange({...value,responsible:e.target.value,customName:""})} style={{fontSize:12,width:"100%",marginBottom:6,padding:"4px 6px"}}>
            <option value="">— select —</option>
            {DEPARTMENTS.map(d=><option key={d}>{d}</option>)}
          </select>
          <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:4}}>or custom name</div>
          <input value={value.customName} onChange={e=>onChange({...value,customName:e.target.value,responsible:""})} placeholder="Type a name…" style={{fontSize:12,width:"100%",marginBottom:6,padding:"4px 6px",boxSizing:"border-box"}}/>
          <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:4}}>Due date</div>
          <input type="date" value={value.dueDate} onChange={e=>onChange({...value,dueDate:e.target.value})} style={{fontSize:12,width:"100%",marginBottom:6,padding:"4px 6px",boxSizing:"border-box"}}/>
          <div style={{fontSize:11,color:"var(--color-text-tertiary)",marginBottom:4}}>Status</div>
          <div style={{display:"flex",gap:4,flexWrap:"wrap",marginBottom:8}}>
            {MAT_STATUSES.map(s=>{const c=MAT_COLORS[s];return(
              <button key={s} onClick={()=>onChange({...value,status:s})} style={{fontSize:11,padding:"2px 8px",borderRadius:99,border:`0.5px solid ${c.border}`,background:value.status===s?c.bg:"transparent",color:c.text,cursor:"pointer"}}>{s}</button>
            );})}
          </div>
          <div style={{display:"flex",justifyContent:"space-between"}}>
            <button onClick={()=>onChange(emptyAssignee())} style={{fontSize:11,color:"var(--color-text-tertiary)",background:"none",border:"none",cursor:"pointer"}}>Clear</button>
            <button onClick={()=>setOpen(false)} style={{fontSize:11,padding:"3px 10px",cursor:"pointer",background:"var(--color-background-info)",color:"var(--color-text-info)",border:"0.5px solid var(--color-border-info)",borderRadius:"var(--border-radius-md)"}}>Done</button>
          </div>
        </div>
      )}
    </div>
  );
}

// ── App ──────────────────────────────────────────────────────────────────────
export default function App() {
  const [events, setEvents] = useState(null);
  const [selected, setSelected] = useState(null);
  const [activeTab, setActiveTab] = useState("levels");
  const [currentUser, setCurrentUser] = useState("Natasha");
  const canEdit = USERS.includes(currentUser);

  useEffect(()=>{
    (async()=>{
      try { const r=await window.storage.get("mnv-v4"); if(r?.value){setEvents(JSON.parse(r.value));return;} } catch(e){}
      setEvents(EVENTS.map(makeEvent));
    })();
  },[]);

  async function save(data) {
    setEvents(data);
    if (selected) setSelected(data.find(e=>e.id===selected.id)||null);
    try { await window.storage.set("mnv-v4",JSON.stringify(data)); } catch(e){}
  }

  function updateEvent(updated) {
    save(events.map(e=>e.id===updated.id?updated:e));
    setSelected(updated);
  }

  if (!events) return <div style={{padding:"2rem",fontSize:13,color:"var(--color-text-secondary)"}}>Loading…</div>;

  const upcoming = events.flatMap(ev=>ev.milestones.map(m=>({...m,evTitle:ev.title,evColor:ev.color}))).filter(m=>{const d=daysLeft(m.date);return d!==null&&d>=0&&d<=21;}).sort((a,b)=>a.date.localeCompare(b.date)).slice(0,8);

  return (
    <div style={{fontFamily:"var(--font-sans)",fontSize:13,minHeight:500}}>
      {/* Header */}
      <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"0.875rem 1.25rem",borderBottom:"0.5px solid var(--color-border-tertiary)"}}>
        <div>
          <div style={{fontSize:15,fontWeight:600,color:"var(--color-text-primary)"}}>Montenova International School</div>
          <div style={{fontSize:12,color:"var(--color-text-secondary)"}}>Event Planning Dashboard · {new Date().toLocaleDateString("en-US",{month:"long",year:"numeric"})}</div>
        </div>
        <div style={{display:"flex",alignItems:"center",gap:8}}>
          <span style={{fontSize:12,color:"var(--color-text-secondary)"}}>Viewing as:</span>
          <select value={currentUser} onChange={e=>setCurrentUser(e.target.value)} style={{fontSize:12,padding:"4px 8px",borderRadius:"var(--border-radius-md)"}}>
            {[...USERS,...DEPARTMENTS].map(u=><option key={u}>{u}</option>)}
          </select>
        </div>
      </div>

      {/* Table */}
      <div style={{overflowX:"auto"}}>
        <table style={{width:"100%",borderCollapse:"collapse",fontSize:12}}>
          <thead>
            <tr style={{background:"var(--color-background-secondary)",borderBottom:"0.5px solid var(--color-border-tertiary)"}}>
              {["Event","Date","Days","Status","Levels","Responsible","Materials",""].map((h,i)=>(
                <th key={i} style={{padding:"8px 12px",textAlign:"left",fontWeight:500,color:"var(--color-text-secondary)",whiteSpace:"nowrap",fontSize:11,textTransform:"uppercase",letterSpacing:"0.04em"}}>{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {events.map(ev=>{
              const dl=daysLeft(ev.date);
              const sc=STATUS_COLORS[ev.status];
              const activeLevels=LEVELS.filter(l=>ev.levels[l].active);
              const matDone=ev.materials.filter(m=>m.status==="Done").length;
              const matTotal=ev.materials.length;
              const isSel=selected?.id===ev.id;
              return (
                <tr key={ev.id} onClick={()=>{setSelected(isSel?null:ev);setActiveTab("levels");}} style={{borderBottom:"0.5px solid var(--color-border-tertiary)",cursor:"pointer",background:isSel?"var(--color-background-info)":"var(--color-background-primary)"}}>
                  <td style={{padding:"10px 12px"}}>
                    <div style={{display:"flex",alignItems:"center",gap:8}}>
                      <div style={{width:3,height:28,borderRadius:2,background:ev.color,flexShrink:0}}/>
                      <span style={{fontWeight:500,color:"var(--color-text-primary)"}}>{ev.title}</span>
                    </div>
                  </td>
                  <td style={{padding:"10px 12px",color:"var(--color-text-secondary)",whiteSpace:"nowrap"}}>{fmtFull(ev.date)}</td>
                  <td style={{padding:"10px 12px",whiteSpace:"nowrap"}}>
                    {dl!==null&&<span style={{fontSize:11,padding:"2px 7px",borderRadius:99,background:dl<=14&&ev.status!=="Completed"?"#FAEEDA":"var(--color-background-secondary)",color:dl<=14&&ev.status!=="Completed"?"#854F0B":"var(--color-text-secondary)",fontWeight:dl<=14?500:400}}>{dl===0?"Today":dl<0?`${Math.abs(dl)}d ago`:`${dl}d`}</span>}
                  </td>
                  <td style={{padding:"10px 12px"}}>
                    <span style={{fontSize:11,padding:"2px 8px",borderRadius:99,background:sc.bg,color:sc.text,border:`0.5px solid ${sc.border}`,whiteSpace:"nowrap"}}>{ev.status}</span>
                  </td>
                  <td style={{padding:"10px 12px"}}>
                    <div style={{display:"flex",gap:4,flexWrap:"wrap"}}>
                      {activeLevels.length===0?<span style={{color:"var(--color-text-tertiary)"}}>—</span>:activeLevels.map(l=><span key={l} style={{fontSize:10,padding:"1px 6px",borderRadius:99,background:ev.color+"22",color:ev.color,border:`0.5px solid ${ev.color}55`,whiteSpace:"nowrap"}}>{l==="Early Years"?"EY":l.split(" ")[0]}</span>)}
                    </div>
                  </td>
                  <td style={{padding:"10px 12px",color:"var(--color-text-secondary)",whiteSpace:"nowrap"}}>{ev.team.mainResponsible}</td>
                  <td style={{padding:"10px 12px"}}>
                    {matTotal>0?(
                      <div style={{display:"flex",alignItems:"center",gap:6}}>
                        <div style={{width:48,height:4,background:"var(--color-border-tertiary)",borderRadius:2,overflow:"hidden"}}>
                          <div style={{width:`${pct(matDone,matTotal)}%`,height:"100%",background:ev.color,borderRadius:2}}/>
                        </div>
                        <span style={{fontSize:11,color:"var(--color-text-secondary)"}}>{matDone}/{matTotal}</span>
                      </div>
                    ):<span style={{color:"var(--color-text-tertiary)"}}>—</span>}
                  </td>
                  <td style={{padding:"10px 12px",textAlign:"right"}}><span style={{fontSize:11,color:"var(--color-text-tertiary)"}}>{isSel?"▲":"▼"}</span></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>

      {/* Milestones strip */}
      {upcoming.length>0&&(
        <div style={{padding:"0.75rem 1.25rem",borderTop:"0.5px solid var(--color-border-tertiary)",background:"var(--color-background-secondary)"}}>
          <div style={{fontSize:11,fontWeight:500,color:"var(--color-text-secondary)",marginBottom:6,textTransform:"uppercase",letterSpacing:"0.04em"}}>Upcoming milestones — next 21 days</div>
          <div style={{display:"flex",gap:8,flexWrap:"wrap"}}>
            {upcoming.map((m,i)=>(
              <div key={i} style={{fontSize:11,padding:"3px 10px",borderRadius:99,background:"var(--color-background-primary)",border:`0.5px solid ${m.evColor}55`,color:"var(--color-text-secondary)"}}>
                <span style={{color:m.evColor,fontWeight:500}}>{m.evTitle.split(" ")[0]}</span> · {m.type} · {fmtFull(m.date)}
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Drawer */}
      {selected&&<DetailDrawer event={selected} onUpdate={updateEvent} canEdit={canEdit} activeTab={activeTab} setActiveTab={setActiveTab} onClose={()=>setSelected(null)} currentUser={currentUser}/>}
    </div>
  );
}

// ── Detail Drawer ─────────────────────────────────────────────────────────────
