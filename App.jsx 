const STATUSES = ["Not started","In progress","On hold","Completed"];
const STATUS_COLORS = {
  "Not started":{ bg:"#F2F2F0", text:"#5F5E5A", border:"#C7C6C2" },
  "In progress": { bg:"#EAF3DE", text:"#3B6D11", border:"#639922" },
  "On hold":     { bg:"#FAEEDA", text:"#854F0B", border:"#BA7517" },
  "Completed":   { bg:"#EEEDFE", text:"#3C3489", border:"#7F77DD" },
};
const MAT_STATUSES = ["To Do","In Progress","Done"];
const MAT_COLORS = {
  "To Do":       { bg:"#F2F2F0", text:"#5F5E5A", border:"#C7C6C2" },
  "In Progress": { bg:"#E6F1FB", text:"#0C447C", border:"#378ADD" },
  "Done":        { bg:"#EAF3DE", text:"#3B6D11", border:"#639922" },
};
